DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
DB_NAME=note_demo
DB_USER=note_demo
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
