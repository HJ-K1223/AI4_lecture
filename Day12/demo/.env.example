# 단계 3: 실행 전 python -m app.core.setup_local로 SESSION_SECRET을 생성하세요.
APP_ENV=development
APP_NAME=소담상점
APP_BASE_URL=http://127.0.0.1:8000
ALLOWED_HOSTS=["127.0.0.1","localhost","testserver"]

# Supabase Connect에서 복사하고 드라이버를 postgresql+psycopg로 지정합니다.
# 실제 값은 .env에만 저장합니다. 비밀번호의 예약문자는 URL 인코딩합니다.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_URL=

# 또는 위 URL을 비우고 아래 분리 설정을 모두 입력해도 됩니다.
# 현재 .env의 host / port / dbname / user / password 이름도 지원합니다.
# DB_HOST=
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=
# DB_PASSWORD=
# 분리 설정의 비밀번호는 원문을 입력합니다. URL 인코딩은 코드가 처리합니다.

# 모든 환경에서 32자 이상의 임의 비밀값이 필수입니다. 실제 값은 커밋하지 않습니다.
SESSION_SECRET=
# 로컬 HTTP에서만 false로 설정할 수 있습니다. 운영은 반드시 true입니다.
COOKIE_SECURE=true
